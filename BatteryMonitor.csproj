<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BatteryMonitor</AssemblyName>
    <RootNamespace>BatteryMonitor</RootNamespace>
    <ApplicationIcon>BatteryMonitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.11.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ReleaseTools/**/*.cs" />
    <EmbeddedResource Include="update-config.json" LogicalName="BatteryMonitor.UpdateConfig.json" />
  </ItemGroup>
</Project>
